APP_NAME=ANIMOJI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://animoji.local

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================================================
# BASE DE DATOS LOCAL (XAMPP / MariaDB) - ACTIVA
# ============================================================================
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=animoji
DB_USERNAME=root
DB_PASSWORD=

# ============================================================================
# BASE DE DATOS EN LA NUBE — SUPABASE (web y app móvil comparten la BD)
# ============================================================================
# 1. Crea el proyecto en https://supabase.com (Plan Free).
# 2. En Supabase → Connect → Postgres copia la "Connection string" y pégala
#    como DB_URL (comenta después el bloque local de arriba).
# 3. Ejecuta: php artisan migrate --force
# 4. Importa los datos de XAMPP: php artisan animoji:importar-supabase
#
# DB_URL=postgresql://postgres:TU_PASSWORD@db.TU-PROYECTO.supabase.co:5432/postgres
# DB_CONNECTION=pgsql
# DB_SSLMODE=require
#
# Conexión local de solo lectura que usa el comando de importación:
# DB_LOCAL_HOST=127.0.0.1
# DB_LOCAL_PORT=3306
# DB_LOCAL_DATABASE=animoji
# DB_LOCAL_USERNAME=root
# DB_LOCAL_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Administrador local (solo se crea con APP_ENV=local)
ANIMOJI_ADMIN_NAME="Administrador ANIMOJI"
ANIMOJI_ADMIN_EMAIL=admin@animoji.local
ANIMOJI_ADMIN_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
